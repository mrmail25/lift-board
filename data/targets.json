  "round_to": 0.5,
  "status": {
   "green": "min <= total <= max",
   "amber_under": "min - 2 <= total < min",
   "amber_over": "max < total <= max * 1.25",
   "red_under": "total < min - 2",
   "red_over": "total > max * 1.25"
  }
 },

  "glutes",
  "biceps",
  "triceps",
  "calves"
 ],
 "rules": [
  {
   "id": "too_many_exercises",
   "severity": "warn",
   "scope": "session",
   "threshold": 7,
   "hard_max": 8,
   "message": "{day} has {n} exercises. Past 7, later exercises are done tired and add little. Cut or move the lowest-priority isolation."
  },
  {
   "id": "junk_volume_session",
   "severity": "warn",
   "scope": "session",
   "threshold": 10,
   "message": "{muscle} gets {sets} effective sets on {day}. Past about 10 in one session, extra sets mostly add fatigue. Move some to another day."
  },
  {
   "id": "sets_per_exercise",
   "severity": "warn",
   "scope": "exercise",
   "threshold": 5,
   "message": "{exercise} on {day} has {sets} sets. More than 5 sets of one exercise gives diminishing returns. Use 2 to 4 sets, or split it across two exercises."
  },
  {
   "id": "low_frequency",
   "severity": "info",
   "scope": "week",
   "threshold": 2,
   "min_effective_to_count": 2,
   "message": "{muscle} is trained meaningfully on only {n} day(s) this week. Twice a week usually grows muscle better for the same total sets."
  },
  {
   "id": "redundant_pattern",
   "severity": "warn",
   "scope": "session",
   "threshold": 2,
   "message": "{day} has {n} {pattern} exercises. Two of the same movement pattern in one session is plenty. Swap one for a different angle or a stretch-biased option."
  },
  {
   "id": "push_pull_imbalance",
   "severity": "warn",
   "scope": "week",
   "min_ratio": 0.75,
   "max_ratio": 2.0,
   "message": "Pull-to-push sets are {ratio}:1 this week. Keep pulling at least about 75% of pushing, and no more than 2x, to protect the shoulders and balance the upper body."
  },
  {
   "id": "missing_stretch",
   "severity": "info",
   "scope": "week",
   "message": "No stretch-biased exercise for {muscle} this week. Add one, like {examples}. Training at long muscle lengths tends to build more muscle."
  },
  {
   "id": "hinge_before_squat",
   "severity": "warn",
   "scope": "week",
   "message": "A heavy deadlift on {day1} is followed by heavy squats on {day2}. The lower back and hips won't have recovered. Put at least a day between them."
  },
  {
   "id": "consecutive_high_volume",
   "severity": "warn",
   "scope": "week",
   "uses": "session.solid",
   "message": "{muscle} gets a solid session on both {day1} and {day2}. Give a muscle at least 48 hours between hard sessions."
  },
  {
   "id": "beginner_squat_and_deadlift",
   "severity": "warn",
   "scope": "session",
   "levels": [
    "beginner"
   ],
   "message": "{day} has both heavy squats and heavy deadlifts. For a beginner, that's too much lower-back fatigue in one day. Split them onto different days."
  },
  {
   "id": "weekly_volume",
   "severity": "warn",
   "scope": "week",
   "uses": "targets",
   "message": "{muscle} is at {sets} weekly sets, outside the {min} to {max} target."
  }
 ]
}
 "rules": [
  {
   "id": "many_small_entries",
   "severity": "info",
   "scope": "session",
   "min_tiles": 10,
   "max_avg_sets": 2,
   "message": "{day} has {n} exercises averaging under 2 sets each. That's a lot of setup for little work. Merge some into fewer exercises with 3 sets."
  },
  {
   "id": "session_hard_sets",
   "severity": "warn",
   "scope": "session",
   "warn_above": {
    "beginner": 20,
    "intermediate": 24,
    "advanced": 28
   },
   "info_band": 4,
   "message": "{day} has {sets} hard sets, above the {max} cap for your level. Move some sets to another day.",
   "message_info": "{day} has {sets} hard sets, close to the {max} cap for your level."
  },
  {
   "id": "session_length",
   "severity": "warn",
   "scope": "session",
   "uses": "targets.analytics.session_length",
   "info_min": 75,
   "warn_min": 90,
   "message": "{day} runs about {min} minutes. Past 90, focus and output drop. Cut sets or split the day.",
   "message_info": "{day} runs about {min} minutes. That's long, so make sure the big lifts come first."
  },
  {
   "id": "spinal_load",
   "severity": "warn",
   "scope": "session+week",
   "counts": "sets of heavy_squats + heavy_hinges",
   "session_warn_above": {
    "beginner": 6,
    "intermediate": 8,
    "advanced": 8
   },
   "week_warn_above": {
    "beginner": 10,
    "intermediate": 14,
    "advanced": 18
   },
   "message": "{day} has {sets} heavy squat and deadlift sets, above {max}. Move some to another day or swap in a machine variant.",
   "message_week": "{sets} heavy squat and deadlift sets this week, above {max}. Swap some for machine or supported variants."
  },
  {
   "id": "junk_volume_session",
   "severity": "warn",
   "scope": "session",
   "threshold": 10,
   "message": "{muscle} gets {sets} effective sets on {day}. Past about 10 in one session, extra sets mostly add fatigue. Move some to another day."
  },
  {
   "id": "sets_per_exercise",
   "severity": "warn",
   "scope": "exercise",
   "threshold": 5,
   "message": "{exercise} on {day} has {sets} sets. More than 5 sets of one exercise gives diminishing returns. Use 2 to 4 sets, or split it across two exercises."
  },
  {
   "id": "low_frequency",
   "severity": "info",
   "scope": "week",
   "threshold": 2,
   "min_effective_to_count": 2,
   "message": "{muscle} is trained meaningfully on only {n} day this week. Twice a week usually grows muscle better for the same total sets.",
   "message_indirect_only": "Only indirect work so far. Add a direct exercise for {muscle}.",
   "message_note": "Use message_indirect_only when the muscle has weekly sets > 0 but no single day reaches min_effective_to_count; otherwise use message."
  },
  {
   "id": "redundant_pattern",
   "severity": "warn",
   "scope": "session",
   "threshold": 10,
   "message": "The {pattern} exercises on {day} add up to {sets} effective sets for {muscle}, past about 10 in one session. Cut sets or move one to another day.",
   "note": "Any number of exercises from the same pattern is fine. This only fires when the pattern's exercises together push one muscle over the per-session cap."
  },
  {
   "id": "push_pull_imbalance",
   "severity": "warn",
   "scope": "week",
   "min_ratio": 0.75,
   "max_ratio": 2.0,
   "message": "Pull-to-push sets are {ratio}:1 this week. Keep pulling at least about 75% of pushing, and no more than 2x, to protect the shoulders and balance the upper body."
  },
  {
   "id": "missing_stretch",
   "severity": "info",
   "scope": "week",
   "message": "No stretch-biased exercise for {muscle} this week. Add one, like {examples}. Training at long muscle lengths tends to build more muscle."
  },
  {
   "id": "hinge_before_squat",
   "severity": "warn",
   "scope": "week",
   "message": "A heavy deadlift on {day1} is followed by heavy squats on {day2}. The lower back and hips won't have recovered. Put at least a day between them."
  },
  {
   "id": "consecutive_high_volume",
   "severity": "warn",
   "scope": "week",
   "uses": "session.solid",
   "message": "{muscle} gets a solid session on both {day1} and {day2}. Give a muscle at least 48 hours between hard sessions."
  },
  {
   "id": "beginner_squat_and_deadlift",
   "severity": "warn",
   "scope": "session",
   "levels": [
    "beginner"
   ],
   "message": "{day} has both heavy squats and heavy deadlifts. For a beginner, that's too much lower-back fatigue in one day. Split them onto different days."
  },
  {
   "id": "weekly_volume",
   "severity": "warn",
   "scope": "week",
   "uses": "targets",
   "message": "{muscle} is at {sets} weekly sets, outside the {min} to {max} target."
  },
  {
   "id": "recovery_vs_baseline",
   "severity": "info",
   "scope": "week",
   "uses": "targets.recovery",
   "app_only": true,
   "message": "This week's recovery cost is {pct}% of your saved normal week. Expect more fatigue than usual.",
   "note": "App-side only. Compares this week's recovery cost with the saved baseline week. The reference checker skips it because it has no baseline."
  }
 ]
}
{
  "expo": {
    "name": "ApeChit",
    "slug": "apechit-dev",
    "scheme": "apechit-dev",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F2F2F4"
    },
    "ios": {
      "bundleIdentifier": "dev.placeholder.apechit",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.placeholder.apechit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8590C"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "bundleIdStatus": "development placeholder only. Not registered with Apple or Google. Replace before any store upload."
    }
  }
}

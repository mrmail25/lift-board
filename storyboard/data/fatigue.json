 "levels_vol11b": {
  "muscle_local": "muscle fatigue per set = rating[m] x fatigue_per_set x effort[RIR + role offset] (effort: RIR 0 1.2, 1 1.1, 2 1.0, 3 0.9, 4+ 0.8; role offsets as in volume-model.json credit). Muscles rated < 0.25 get 0.",
  "systemic": "systemic fatigue per set = fatigue_per_set x effort[planned RIR], charged once per set (exercise and day level)",
  "anchor_stimulus": "one machine-chest-press set = 1 hard-set eq of prime + secondary stimulus (chest 1; its minor credits front_delts/triceps are excluded); exercise/day stimulus is divided by this so the anchor reads 1.0",
  "sentences": {
   "muscle": "Muscle S:F = hard-set equivalents on that muscle / fresh-set fatigue on that muscle (rating-weighted); 1.0 = one machine chest press set on chest.",
   "exercise": "Exercise S:F = stimulus on its prime and secondary muscles (rating >= 0.5, or its top rating) / its systemic fatigue, both counted in machine-chest-press sets; 1.0 = as efficient as a machine chest press set.",
   "day": "Day S:F = the same ratio summed over all sets of the day (each set's fatigue charged once, not per muscle); 1.0 = a day as efficient as machine chest press sets."
  }
 }
}
